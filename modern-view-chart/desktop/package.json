{
  "name": "vivutrade-desktop",
  "version": "1.0.0",
  "private": true,
  "main": "main.cjs",
  "description": "Vivutrade native desktop shell",
  "author": "VivuTrade",
  "scripts": {
    "start": "electron .",
    "prepare:icon": "node scripts/generate-icon.cjs",
    "dist": "npm run prepare:icon && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^37.3.1",
    "electron-builder": "^26.8.1",
    "png-to-ico": "^2.1.8"
  },
  "build": {
    "compression": "store",
    "appId": "vn.vivutrade.desktop.native.v2",
    "productName": "Vivutrade Desktop Native",
    "executableName": "VivutradeDesktopNative",
    "directories": {
      "output": "../public/downloads/desktop-native"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "../public/downloads/installer/assets/bridge",
        "to": "bridge",
        "filter": [
          "**/*",
          "!**/__pycache__/**"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false,
      "icon": "assets/vivutrade-logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
