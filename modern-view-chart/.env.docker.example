# Core backend
PORT=8091
FRONTEND_HOST_PORT=13000
BACKEND_HOST_PORT=18091
MONGO_HOST_PORT=27028
ACCESS_TOKEN=replace-with-long-random-token
URL_MONGOOSE=mongodb://viewx-mongo:27017/viewx?directConnection=true
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://staging.vivutrade.io.vn
MAX_WS_CLIENTS=150
WS_MSG_RATE_PER_10S=60
BRIDGE_WS_MSG_RATE_PER_10S=15000
CORE_SYMBOLS=XAUUSDm,BTCUSDm,ETHUSDm,EURUSDm,GBPUSDm

# Frontend runtime proxy (inside frontend container)
BACKEND_ORIGIN=http://backend:8091
NEXT_PUBLIC_WS_URL=
NEXT_PUBLIC_STRATEGY_ENGINE_ENABLED=false

# Bridge host must point to Docker-published backend port
NODE_WS_URL=ws://127.0.0.1:18091

# Optional auth/provider settings
AUTH_ACCESS_JWT_SECRET=
AUTH_REFRESH_JWT_SECRET=
JWT=replace-with-jwt-secret
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GEMINI_API_KEY=
TELEGRAM_AI_PROVIDER=gemini
TELEGRAM_AI_MODEL=gemma-4-26b-a4b-it

# Optional bot/webhook settings
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
